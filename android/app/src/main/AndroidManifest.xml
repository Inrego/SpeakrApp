<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- The only foreground service this app starts is
         .audio.AudioCaptureService (see below), which calls startForeground
         with MICROPHONE, or MICROPHONE|MEDIA_PROJECTION while capturing
         system audio. No dataSync service exists: WorkManager runs the
         auto-upload job as ordinary (non-expedited) work, so
         FOREGROUND_SERVICE_DATA_SYNC is deliberately not declared. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <!-- Required by androidx.work, which merges it in regardless; kept
         explicit so the manifest documents the app's own surface. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Auto-upload from folder. Folder access itself goes through the
         Storage Access Framework (a persisted ACTION_OPEN_DOCUMENT_TREE
         grant taken in packages/speakr_saf), so no storage permission is
         declared here - not READ_MEDIA_AUDIO and not READ_EXTERNAL_STORAGE
         either. On Android every candidate file is listed, read and deleted
         through the tree grant (lib/features/auto_upload/auto_upload_files.dart),
         and the folder picker is ACTION_OPEN_DOCUMENT_TREE, so the raw
         dart:io path in that file is Windows-only. -->

    <!-- ACTION_PHONE_STATE_CHANGED is a protected broadcast: without this
         the PhoneStateReceiver below is never delivered. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <!-- WorkManager reschedules its periodic auto-upload job after a
         reboot (androidx.work RescheduleReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Ongoing notification for the recording foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="Minutes"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Fires the auto-upload scan when a phone call ends. -->
        <receiver
            android:name=".PhoneStateReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE"/>
            </intent-filter>
        </receiver>

        <!-- Foreground service hosting the live recorder. mediaProjection
             is required for capturing other apps' audio; microphone keeps
             the mic source allowed to run while the screen is off. -->
        <service
            android:name=".audio.AudioCaptureService"
            android:foregroundServiceType="mediaProjection|microphone"
            android:exported="false" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
